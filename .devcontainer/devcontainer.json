{
  "name": "rslcpp (Pilot Auto X2 Gen2 v4.3.1)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "USERNAME": "autoware"
    }
  },
  "updateRemoteUserUID": true,
  "remoteUser": "autoware",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postStartCommand": [
    "git",
    "config",
    "--global",
    "--add",
    "safe.directory",
    "${containerWorkspaceFolder}"
  ]
}